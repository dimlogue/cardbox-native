<?xml version="1.0" encoding="utf-8"?>
<!-- Q148（2.59）：窗底改雾蓝页底同族色——冷启 starting window 不再纯白闪屏
     （用户点名「点开一片空白」）；widget 默认仍走浅色框架主题与原先逐位一致，
     只换 windowBackground 一项。深档见 values-night。 -->
<resources>
    <style name="Theme.CardDB" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#E2EDF9</item>
        <!-- Q151（N16）：Android 12+ 启动屏走系统 SplashScreen，其背景默认取
             colorBackground 回落白——windowBackground 设了雾蓝真机仍先白闪正源
             在此。补 windowSplashScreenBackground 与窗底同色，点图标第一眼即雾蓝。 -->
        <item name="android:windowSplashScreenBackground">#E2EDF9</item>
        <item name="android:statusBarColor">#E2EDF9</item>
        <item name="android:navigationBarColor">#E2EDF9</item>
    </style>
</resources>
